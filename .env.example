# Local API. Real .env files and database files are excluded from Git.
PORT=3001
HOST=127.0.0.1
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
DATABASE_DIR=./.data/lumo

# Production: set NODE_ENV=production, HTTPS APP_ORIGINS and DATABASE_URL.
# On Render, remove local APP_ORIGINS: RENDER_EXTERNAL_URL supplies the exact origin.
# HOST=0.0.0.0
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# TRUST_PROXY_HOPS=1
# VITE_API_URL is optional, for a same-site API on another origin.
# Prefer hosting the frontend and API together; unrelated domains may block cookies.
